root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{md,html,css,yml,yaml,json,toml}]
indent_size = 2
trim_trailing_whitespace = false

# 批处理一律保持纯 ASCII + CRLF：ASCII 字节在任何代码页下都相同，
# 不会因为控制台代码页（936 / 65001）不同而乱码
[*.bat]
end_of_line = crlf
